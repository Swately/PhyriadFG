// shaders/fg_core.comp — stage 5 GENERATE: the LAYERTAB kernel (R3 of CONVERGENCE_MASTER_PLAN.md).
//
// One dispatch per tick over the output extent. Structure (Candidate C §3.5, fixed and total):
//     MVCOND chain → SAMPLE chain → fg_sample() → [tile reduction] → WEIGHT chain → fg_blend() → COMPOSE chain → ONE store
// Every chain is GENERATED by tools/layer_gen.cpp from src/layers/layer_table.def (the single declaration
// site); every row body is shaders/layers/<name>.glsl; a disabled row is a specialization constant folded
// at pipeline creation. The core itself is shaders/fg_core_math.glsl and touches no layer parameter.
//
// Bindings 0..13 are the SAME set layout as wap_warp.comp (the host writes the same fourteen views into
// this pipeline's set), so the two kernels are fed identical inputs — that is what makes the --fg-core-ab
// byte-diff a same-tick, same-input comparison. Bindings this kernel does not read (9 mass counter, 11
// contour field, 13 prev-output) are not declared here; they stay in the layout as unused entries.
// Binding 15 = the generated LayerParams UBO (config-time, written once by the host).
//
// Push = CorePush (20 B: the six contract parameters + t + arm_mask, A0 M2c / STAGE_CONTRACT stage 5)
// followed by the per-generation SCALAR block of FlowSet[gen] — the gme affine model, six floats. It is
// FlowSet data (like t and arm_mask, which also ride in the push), not a layer parameter, which is why it
// is not in the UBO; a declared deviation from Candidate C §2's "20 B of fields", recorded in R3's record.
//
// Why the barrier is unconditional: the MV is sampled bilinearly, so the per-tile gate is not uniform
// across the workgroup; the shared-memory barrier MUST sit at main()'s top level, outside any conditional.
// OOB invocations run the whole body (writing 0 to s_d) and only skip the store (as wap_warp.comp).
//
// Made with my soul - Swately <3
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_prev_real;          // frame A (phase 0)
layout(set = 0, binding = 1) uniform sampler2D u_cur_real;           // frame B (phase 1)
layout(set = 0, binding = 2) uniform sampler2D u_motion_vectors;     // RG16F, W/8 forward field, pixel units
layout(set = 0, binding = 3) uniform sampler2D u_sad_field;          // RG16F: R = sad_best, G = sad_zero
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D u_output;
layout(set = 0, binding = 5) uniform sampler2D u_motion_vectors_bwd; // RG16F, cur→prev, pixel units
layout(set = 0, binding = 6) uniform sampler2D u_dissidence;         // R8 (mv_edge_snap G1 guidance)
layout(set = 0, binding = 7) uniform sampler2D u_dissidence_bwd;     // R8 (declared for layout parity; unread in R3)
layout(set = 0, binding = 8) uniform sampler2D u_persistence;        // R8, per-block static-history counter / 255
layout(set = 0, binding = 10) uniform sampler2D u_candidates;        // RGBA16F: .xy runner-up MV, .z its SAD
layout(set = 0, binding = 12) uniform sampler2D u_mv_target;         // RG16F: prev-pair MV (PREDICT) / real next-pair MV (EXACT)

layout(push_constant) uniform FgPush {
    float residual_ceil;        // CorePush — the six-parameter core contract (A0 M2c)
    float improvement_frac;
    float agreement_threshold;
    float t;
    uint  arm_mask;             // per-generation row validity (bit = layer id), derived ONCE per tick from FlowSet[gen] (XR5)
    float gme_a, gme_b, gme_c;  // FlowSet[gen] scalars: the affine model mv(gx,gy) = (a + b·gx + c·gy, d + e·gx + f·gy)
    float gme_d, gme_e, gme_f;
} pc;

#include "layer_specconst.glsl"   // GENERATED: layout(constant_id = <id>) const bool L_<NAME>
#include "layer_params.glsl"      // GENERATED: the LayerParams UBO (binding 15) + per-row aliases
#include "fg_core_math.glsl"      // the core: LayerCtx, fg_sample / fg_blend / fg_crossfade
#include "fg_helpers.glsl"        // guided_mv / edge_snap_mv / gme_model_mv — verbatim from wap_warp.comp
#include "layer_includes.glsl"    // GENERATED: the row bodies, rank-ordered

shared float s_d[64];

void main() {
    LayerCtx ctx;
    ctx.coord    = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 out_size = imageSize(u_output);
    const bool  valid    = (ctx.coord.x < out_size.x && ctx.coord.y < out_size.y);
    ctx.out_size = vec2(out_size);
    ctx.uv       = (vec2(ctx.coord) + vec2(0.5)) / vec2(out_size);   // uv0 (wap_warp.comp:290); no UV stage in R3
    ctx.t        = pc.t;
    ctx.mv_raw_fwd   = vec2(0.0);
    ctx.sad          = vec2(0.0);
    ctx.A_samp       = vec4(0.0);
    ctx.B_samp       = vec4(0.0);
    ctx.d_pixel      = 0.0;
    ctx.blend        = vec4(0.0);
    ctx.stasis_block = false;
    ctx.warp_ok      = false;

    // ── MVCOND: vec2 mv, conditioned in declared rank order (pseudo-rows write ctx fields) ────────
#include "chain_mvcond.glsl"
    // ── SAMPLE: vec2 mv_s — flows ONLY into fg_sample() ──────────────────────────────────────────
#include "chain_sample.glsl"

    // ── THE CORE, sample half ────────────────────────────────────────────────────────────────────
    const CoreSample cs = fg_sample(u_prev_real, u_cur_real, ctx.uv, mv_s, ctx.t, ctx.out_size, ctx.sad,
                                    pc.residual_ceil, pc.improvement_frac);
    // Gate 2 (source agreement): the per-tile MEAN of d over the 8x8 workgroup — wap_warp.comp:523-528.
    s_d[gl_LocalInvocationIndex] = valid ? cs.d_pixel : 0.0;
    barrier();
    float d_sum = 0.0;
    for (uint i = 0u; i < 64u; ++i) d_sum += s_d[i];
    const float d_tile       = d_sum / 64.0;
    const bool  tile_agrees  = (d_tile < pc.agreement_threshold);
    ctx.A_samp  = cs.A;
    ctx.B_samp  = cs.B;
    ctx.d_pixel = cs.d_pixel;
    ctx.warp_ok = cs.gate1 && tile_agrees;
    ctx.blend   = fg_crossfade(u_prev_real, u_cur_real, ctx.uv, ctx.t);   // CH_BLEND (:694-695)

    // ── WEIGHT: float wa (identity 1 - t), re-weighted by rows between the samples and the blend ──
#include "chain_weight.glsl"

    // ── THE CORE, blend half ─────────────────────────────────────────────────────────────────────
    CoreOut core;
    core.color = fg_blend(wa, cs.A, cs.B);   // :679

    // ── COMPOSE: vec4 c_out = f(c_in, ctx) per row; the ONLY store source (G1) ───────────────────
#include "chain_compose.glsl"

    if (valid) imageStore(u_output, ctx.coord, c_out);
}
