# ── Build output ────────────────────────────────────────────────
build-render-assistant/
build*/
*.exe
*.obj
*.pdb
*.spv
*.ilk
*.exp
*.lib

# ── UI (Tauri) — generated / vendored, never versioned ──────────
ui/node_modules/
ui/dist/
ui/src-tauri/target/
# ui/webview2: fixed WebView2 runtime (downloaded MS cab, ~149MB) — re-fetchable, not vendored
ui/webview2/
ui/Microsoft.WebView2*
*.cab
.vscode/

# ── LaTeX intermediates (keep .tex + rendered .pdf/.png) ────────
*.aux
*.log
*.log1
*.log2
*.out
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz

# ── Release artifacts (attached to GitHub releases, not versioned) ──
*.zip
dist/

# ── Scratch / diagnostics (gitignored campaign artifacts) ───────
frames/
*.bak
*.rej
*.patch
ra_out*.txt
c7_*.txt
pslab_run/

# Python bytecode (a .pyc was committed by a `git add -A` on 2026-09-03; untracked 2026-09-04)
__pycache__/
*.pyc

# Run artifacts of tools/r5_pressure.ps1 (CSV + logs, ~2.5 MB per run). The harness is tracked;
# its outputs are not — a `git add -A` on 2026-09-06 committed 5.4 MB of them before this line existed.
tools/r5/
