// PhyriadFG — src/layers/layer_table.def : THE REGISTRY. One PFG_LAYER block per layer.
// Nothing else declares a layer. Rows are the shipping default set of shaders/wap_warp.comp
// (Candidate C §4.1–4.8, source ranges cited per row), in (stage, rank) order.
//
// Macros (defined by the includer — layer_table.hpp expands them three ways):
//   PFG_LAYER(ID, name, stage, rank, kind, default_on, overrides, requires, req_any, excludes,
//             reads, writes, shadows, arm, group, on_flag, off_flag, dominates_ok, help)
//   PFG_PARAM(ID, pname, type, dflt, lo, hi, flag, flag_alias, pflags, ui, help)
//   PFG_LAYER_END(ID)
//   PFG_PSEUDO(ID, name, stage, rank, text)      — a Kind::X row (ordering fact, no body)
//
// Stage R0: the rows exist for the registry (parser shadow, help, UI model, dump, hash, GLSL
// generation). Stage R3: every fused row has its body in shaders/layers/<name>.glsl and
// shaders/fg_core.comp runs the generated chains (opt-in --fg-core; wap_warp.comp stays the default).
// tools/layer_gen.cpp checks each body against its row (entry point, alias-only UBO reads, the
// declared-`needs` rule for cross-row parameter reads, the overrides/c_in rule, the signature).
// R0 also does NOT resolve `requires`/`excludes` — resolve_config()'s cascades still own that
// (parity is measured PRE-cascade, see layer_config_parity()).

// ── MVCOND ─────────────────────────────────────────────────────────────────────────────────────
// rank 0 — the primary MV source (wap_warp.comp:326). Not user-toggleable: it IS the mv-source
// parameter of the core contract (A0 M2c).
PFG_LAYER(FETCH_MV, "fetch_mv", MVCOND, 0, F, true, false, 0u, false, 0u,
          CH_NONE, CH_MV, SH_NONE, ALWAYS, "MV",
          nullptr, nullptr, nullptr,
          "The primary MV source: LINEAR (bilinear) fetch of the W/8 forward field.")
PFG_LAYER_END(FETCH_MV)

// rank 5 — --mv-edge-snap {1|2} (wap_warp.comp:319–327 precedence test). DEFAULT OFF. Its
// presence disables mv_guided's call (today's `else`): declared as excludes on rank 10.
PFG_LAYER(MV_EDGE_SNAP, "mv_edge_snap", MVCOND, 5, F, false, false, 0u, false, 0u,
          CH_MV | CH_PREV | CH_CUR | CH_DISSIDENCE, CH_MV, SH_NONE, ALWAYS, "MV",
          nullptr, nullptr, nullptr,
          "Cross-bilateral (edge-aware sub-block) primary MV fetch. 1 = G1 (dissidence-class guidance), "
          "2 = G2 (color-class guidance). Supersedes mv_guided's single-corner pick when armed. WAP-path only.")
  PFG_PARAM(MV_EDGE_SNAP, variant, I32, 0.f, 0.f, 2.f, "--mv-edge-snap", nullptr, PF_IMPLIES_ON | PF_ZERO_OFF, NUMBER,
            "Variant: 0 = off, 1 = G1, 2 = G2.")
  PFG_PARAM(MV_EDGE_SNAP, sim, F32, 0.f, 0.02f, 0.5f, "--mes-sim", nullptr, PF_NONE, NUMBER,
            "Guidance band override for --mv-edge-snap (0 = use --mv-sim), clamped [0.02,0.5].")
PFG_LAYER_END(MV_EDGE_SNAP)

// rank 10 — --mv-guided (guided_mv(), wap_warp.comp:179–202). DEFAULT ON.
PFG_LAYER(MV_GUIDED, "mv_guided", MVCOND, 10, F, true, false, 0u, false, PFG_BIT(MV_EDGE_SNAP),
          CH_MV | CH_PREV | CH_CUR, CH_MV, SH_NONE, ALWAYS, "MV",
          nullptr, "--no-mv-guided", nullptr,
          "Color-guided MV assignment (the contour-membership principle): pick the MV-grid corner whose "
          "color class matches the pixel. Off = blind bilinear fetch.")
  PFG_PARAM(MV_GUIDED, sim, F32, 0.10f, 0.02f, 0.5f, "--mv-sim", nullptr, PF_NONE, NUMBER,
            "Color-membership band, max-channel [0,1] units, clamped [0.02,0.5].")
PFG_LAYER_END(MV_GUIDED)

// rank 20 — --inertia (the persistence tap 304–306 + the gate 332–334). DEFAULT ON at 0.50.
// requires ANY of {mv_guided, mv_edge_snap} (Candidate C §4.2 — the first evidence for req_any).
PFG_LAYER(INERTIA, "inertia", MVCOND, 20, F, true, false, PFG_BIT(MV_GUIDED) | PFG_BIT(MV_EDGE_SNAP), true, 0u,
          CH_MV | CH_PERSIST, CH_MV, SH_NONE, ALWAYS, "MV",
          nullptr, "--no-inertia", nullptr,
          "The inertia prior (motion-state hysteresis): a block whose persistence p >= thresh keeps its "
          "prior MV against the guided pick. WAP-only.")
  PFG_PARAM(INERTIA, thresh, F32, 0.50f, 0.1f, 1.0f, "--inertia-thresh", nullptr, PF_NONE, NUMBER,
            "Persistence cutoff, R8-norm [0.1,1.0]. 0.5 ~ 8 static pairs at 60 fps source.")
PFG_LAYER_END(INERTIA)

// rank 25 — the classification's raw forward leg (wap_warp.comp:344) — the snapshot phase_anchor
// rebases on (which is why bg_reclaim's damp is dead under the default: A3_CHOSEN_DESIGN §3).
PFG_PSEUDO(SNAP_MV_RAW_FWD, ":snapshot mv_raw_fwd", MVCOND, 25, "ctx.mv_raw_fwd = mv;   /* wap_warp.comp:344 */")

// rank 30 — --bg-reclaim [F] (358–396). DEFAULT ON at 4.0. requires gme; arm = GME.
PFG_LAYER(BG_RECLAIM, "bg_reclaim", MVCOND, 30, F, true, false, 0u, false, 0u,
          CH_MV | CH_PREV | CH_CUR | CH_GME, CH_MV, SH_NONE, GME, "MV",
          nullptr, "--no-bg-reclaim",
          "A3_CHOSEN_DESIGN s3: under the shipping default phase_anchor (rank 40) rebases on the rank-25 "
          "snapshot and discards this damp whenever the bwd field is valid; reproduced bug-for-bug (XR7).",
          "Tile-scale gravity fix: damp a gme-nonconform background-fringe MV toward the global model "
          "(or toward ZERO for screen-static overlay pixels).")
  PFG_PARAM(BG_RECLAIM, strength, F32, 4.0f, 0.0f, 4.0f, "--bg-reclaim", "--bg-reclaim-strength",
            PF_IMPLIES_ON | PF_OPTIONAL_VALUE | PF_ZERO_OFF, NUMBER,
            "Snap weight scale [0,4]: ~1 = soft LSFG-style decay, 4 = hard snap (the shipping default). 0 = off.")
PFG_LAYER_END(BG_RECLAIM)

// rank 40 — --phase-anchor (397–411). DEFAULT ON. Needs the bwd field (bidir) → arm = BWD.
PFG_LAYER(PHASE_ANCHOR, "phase_anchor", MVCOND, 40, F, true, false, 0u, false, 0u,
          CH_MV_RAW_FWD | CH_MV_BWD, CH_MV, SH_NONE, BWD, "MV",
          nullptr, "--no-phase-anchor", nullptr,
          "Phase-anchored primary MV: at low t the forward field, at high t the cur-anchored backward "
          "field, blended by smoothstep(0.35,0.65,t). Needs bidir (the bwd field valid this generation).")
PFG_LAYER_END(PHASE_ANCHOR)

// rank 45 — the sad tap (412–414) + the stasis predicate evaluation (publishes CH_STASIS).
PFG_PSEUDO(SAMPLE_SAD_STASIS, ":sample sad ; :eval stasis", MVCOND, 45, "ctx.sad = texture(u_sad_field, ctx.uv).xy; ctx.stasis_block = (L_STASIS && (ctx.sad.y <= STASIS_thresh));   /* wap_warp.comp:412-414, :1191 predicate */")

// rank 50 — --ambig (426–444). DEFAULT ON. requires gme; arm = GME.
PFG_LAYER(AMBIG, "ambig", MVCOND, 50, F, true, false, 0u, false, 0u,
          CH_MV | CH_CANDIDATES | CH_DISSIDENCE | CH_GME, CH_MV, SH_NONE, GME, "MV",
          nullptr, "--no-ambig", nullptr,
          "The AMBIGUITY channel (the periodic-texture killer): when the matcher's runner-up is near-tied, "
          "arbitrate by the gme model / dissidence instead of the arbitrary pick.")
  PFG_PARAM(AMBIG, tie_ratio, F32, 1.15f, 1.0f, 2.0f, nullptr, nullptr, PF_NONE, HIDDEN,
            "Near-tie ratio (internal constant, wap_warp.comp:426–444).")
  PFG_PARAM(AMBIG, min_sep_px, F32, 2.0f, 0.0f, 16.0f, nullptr, nullptr, PF_NONE, HIDDEN,
            "Minimum candidate separation in px (internal constant).")
PFG_LAYER_END(AMBIG)

// ── SAMPLE ─────────────────────────────────────────────────────────────────────────────────────
// rank 110 — --vblend (507–514). DEFAULT ON. Its return flows ONLY into fg_core()'s mv argument.
PFG_LAYER(VBLEND, "vblend", SAMPLE, 110, F, true, false, 0u, false, 0u,
          CH_MV | CH_MV_TARGET, CH_MV_SAMPLE, SH_NONE, ALWAYS, "Warp",
          "--vblend", "--no-vblend", nullptr,
          "Velocity-continuity warp: near the pair's END (high t) tilt the effective sample-offset MV "
          "toward the next pair's velocity (anti pulse). Everything downstream keeps the RAW mv.")
  PFG_PARAM(VBLEND, t0, F32, 0.6f, 0.0f, 0.95f, "--vblend-t0", nullptr, PF_NONE, NUMBER,
            "Phase where the tilt ramp begins (smoothstep(t0,1,t)), clamped [0,0.95].")
  PFG_PARAM(VBLEND, strength, F32, 0.5f, 0.0f, 1.0f, "--vblend-strength", nullptr, PF_NONE, NUMBER,
            "Max tilt weight at t=1 (mix fraction toward the next pair's MV), clamped [0,1].")
  PFG_PARAM(VBLEND, exact, BOOL, 0.f, 0.f, 1.f, "--vblend-exact", nullptr, PF_IMPLIES_ON, SWITCH,
            "EXACT velocity-continuity: the REAL next-pair MV via +1 pair of present lead (adds ~1 source "
            "frame of latency). Default = PREDICT (2*mv - mv_prev).")
PFG_LAYER_END(VBLEND)

// ── WEIGHT ─────────────────────────────────────────────────────────────────────────────────────
// (R3, COLUMN_CLOSURE_EXPERIMENT.md §2.1) rows that re-weight the A/B contribution BETWEEN the core's
// samples and its blend: `float f(float wa, ctx)`, identity wa = 1 − t (wap_warp.comp:637).
// rank 190 — single_track's re-weight (wap_warp.comp:678 `wa_eff = single_track ? 0 : wa`). requires
// single_track (ALL). This was the first of single_track's four `shadows` (SH_WA_EFF_ZERO); as a WEIGHT
// row the wart dissolves into the schema. Not user-toggleable: it follows single_track.
PFG_LAYER(SINGLE_TRACK_WA, "single_track_wa", WEIGHT, 190, F, true, false, PFG_BIT(SINGLE_TRACK), false, 0u,
          CH_NONE, CH_NONE, SH_NONE, ALWAYS, "Composition",
          nullptr, nullptr, nullptr,
          "single_track's WEIGHT half: the core blend collapses to the B-track (wa = 0). Follows single_track.")
PFG_LAYER_END(SINGLE_TRACK_WA)
// ── COMPOSE ────────────────────────────────────────────────────────────────────────────────────
// rank 260 — the warp-vs-blend SELECT (wap_warp.comp:1177-1184, the hard binary path): warp_ok ? c_in :
// ctx.blend. DEFAULT ON, not user-toggleable — it is the core's own selection, expressed as a row so the
// second accumulator is a declared channel (CH_BLEND) and the select an attributable rank
// (COLUMN_CLOSURE_EXPERIMENT.md §2.2). Under the shipping default its output is discarded by rank 290.
PFG_LAYER(SELECT, "select", COMPOSE, 260, F, true, false, 0u, false, 0u,
          CH_WARP_OK | CH_BLEND, CH_NONE, SH_NONE, ALWAYS, "Composition",
          nullptr, nullptr, nullptr,
          "The warp-vs-blend select (hard path): the core's blend where both gates pass, the un-warped "
          "crossfade elsewhere. The soft-gate / commit-default / multicand variants are not rows in R3.")
PFG_LAYER_END(SELECT)
// rank 280 — --stasis (the pre-store bypass, wap_warp.comp:1191). DEFAULT ON. OVERRIDE.
PFG_LAYER(STASIS, "stasis", COMPOSE, 280, F, true, true, 0u, false, 0u,
          CH_STASIS | CH_CUR, CH_NONE, SH_NONE, ALWAYS, "Composition",
          nullptr, "--no-stasis",
          "declared OVERRIDE: a block proven static (sad_zero <= thresh) presents the real pixel directly.",
          "The stasis layer (the HUD fix): a pixel whose block sad_zero <= thresh bypasses the warp and "
          "shows the real. Works on ANY stack; zero extra cost.")
  PFG_PARAM(STASIS, thresh, F32, 0.50f, 0.05f, 8.0f, "--stasis-thresh", nullptr, PF_NONE, NUMBER,
            "sad_zero cutoff: per-8x8-block SUM of |A-B| over RGB in [0,1] color units, range [0,192], "
            "clamped [0.05,8.0].")
PFG_LAYER_END(STASIS)

// rank 290 — --single-track (1321–1329). DEFAULT ON (v3.2). OVERRIDE (c_in deliberately discarded).
// shadows = the legacy's four upstream reaches into the core (Candidate C §4.7). R3: SH_WA_EFF_ZERO became the
// WEIGHT row single_track_wa; the other three (blend base = cur :692, forced warp select :1089, commit/ts-smooth
// inert :810/:1267) write accumulators the :1321 override discards — DEAD under the override, verified 2026-09-05,
// so fg_core.comp does not reproduce them and no output byte depends on them. Kept declared and printed.
PFG_LAYER(SINGLE_TRACK, "single_track", COMPOSE, 290, F, true, true, 0u, false, 0u,
          CH_B_SAMP | CH_CUR | CH_PREV | CH_D_PIXEL | CH_STASIS, CH_NONE,
          SH_BLEND_BASE | SH_FORCE_WARP | SH_COMMIT_INERT, ALWAYS, "Composition",
          "--single-track", "--no-single-track",
          "declared OVERRIDE: the composite base becomes the B-track (cur warped back to phase) plus the "
          "per-pixel screen-static evidence mix; the A/B blend world is discarded by design (operator-eye PASS 2026-07-03).",
          "Single-track synthesis (v3.2): present the pure B-track + the screen-static evidence mix "
          "(d_pixel vs d_zero; the block-proven stasis saturates it). Off = the A/B blend world.")
  PFG_PARAM(SINGLE_TRACK, no_stasis, BOOL, 0.f, 0.f, 1.f, "--st-no-stasis", nullptr, PF_NONE, SWITCH,
            "Variant v3.0: pure B_samp at the pre-store site (no stasis/screen-static term).")
PFG_LAYER_END(SINGLE_TRACK)

// ── FLOW (stage 3, thread F) — R5 step 1: DECLARED (docs/planning/aap/FLOW_ROW_MAP.md §1). ────────
// Kind H = a host pass (CPU, over FlowSet fields); P = an SG pass on F's queue. Ranks preserve today's
// execution order in flow.cpp (source → smooth → candidates → bidir → persistence → gme → memory → objects
// → the backward legs → mem_refresh → the consensus). In this step the rows are the registry's truth
// (dump, help, UI model, parity, hash); the bodies still run under flow.cpp's hand-written conditions —
// step 3 binds them. Source lines are flow.cpp unless noted.

// rank 0 — the motion source (the OFP fwd match, record sites :1963–2000 / :2103–2117). Not toggleable:
// it IS the flow-class source (the FLOW twin of fetch_mv). --nvofa = the hardware provider (PARAM).
PFG_LAYER(FLOW_SOURCE, "flow_source", FLOW, 0, P, true, false, 0u, false, 0u,
          CH_PREV | CH_CUR, CH_MV_RAW_FWD | CH_SAD, SH_NONE, ALWAYS, "Flow",
          nullptr, nullptr, nullptr,
          "The motion source: the pyramid block-match (OpticalFlowPipeline) on the pair, MV + SAD at W/8. "
          "Not user-toggleable; --nvofa selects the NVIDIA hardware provider (auto-fallback if absent).")
  PFG_PARAM(FLOW_SOURCE, nvofa, BOOL, 0.f, 0.f, 1.f, "--nvofa", nullptr, PF_NONE, SWITCH,
            "Provider: 0 = the classical block-match, 1 = the NVIDIA Optical Flow Accelerator (single-GPU, flow_div=1, hardware-gated).")
PFG_LAYER_END(FLOW_SOURCE)

// rank 10 — --mv-smooth F (:269–291, dispatch :1991–2000). DEFAULT OFF (alpha 0). Reads its own gen−1 store.
PFG_LAYER(MV_SMOOTH, "mv_smooth", FLOW, 10, P, false, false, PFG_BIT(FLOW_SOURCE), false, 0u,
          CH_MV_RAW_FWD | CH_MV_PREV_GEN, CH_MV_RAW_FWD, SH_NONE, ALWAYS, "Flow",
          nullptr, nullptr, nullptr,
          "Temporal EMA of the MV field against the previous generation (velocity-space, cut-guarded). 0 = off.")
  PFG_PARAM(MV_SMOOTH, alpha, F32, 0.f, 0.f, 1.f, "--mv-smooth", nullptr, PF_IMPLIES_ON | PF_ZERO_OFF, NUMBER,
            "EMA alpha [0,1]; 0 = off; ~0.6 damps tile jitter.")
PFG_LAYER_END(MV_SMOOTH)

// rank 20 — the second-best candidate emission (:2035–2039; emit_second_best at flow_init.cpp:40). DEFAULT ON.
// Shares --no-ambig with the MVCOND ambig row (the consumer): one hand field, two rows (FLOW_ROW_MAP §2.2).
PFG_LAYER(CANDIDATES, "candidates", FLOW, 20, P, true, false, PFG_BIT(GME), false, 0u,
          CH_MV_RAW_FWD, CH_CANDIDATES, SH_NONE, PRIOR, "Flow",
          nullptr, "--no-ambig", nullptr,
          "Emit the matcher's runner-up per block (the AMBIGUITY channel's producer); the MVCOND ambig row arbitrates it "
          "against the gme model. Needs gme (the referee).")
PFG_LAYER_END(CANDIDATES)

// rank 30 — --bidir (:1488–1532). DEFAULT ON. Armed per pair by CONTROL: not under tier 5, not pipelined, not bwd-skipping.
PFG_LAYER(BIDIR, "bidir", FLOW, 30, P, true, false, PFG_BIT(FLOW_SOURCE), false, 0u,
          CH_PREV | CH_CUR, CH_MV_BWD | CH_SAD, SH_NONE, BIDIR_OK, "Flow",
          nullptr, "--no-bidir", nullptr,
          "The backward match (cur→prev) on the same pair: MV bwd + its SAD; the occlusion classification and the "
          "backward legs of gme/memory/objects need it.")
PFG_LAYER_END(BIDIR)

// rank 35 — the inertia field producer (consume_wap :1411–1426 → hostPER). DEFAULT ON. Shares --no-inertia with
// the MVCOND inertia row (the consumer) — FLOW_ROW_MAP §2.2.
PFG_LAYER(PERSISTENCE, "persistence", FLOW, 35, H, true, false, PFG_BIT(FLOW_SOURCE), false, 0u,
          CH_MV_RAW_FWD | CH_SAD | CH_PERSIST, CH_PERSIST, SH_NONE, ALWAYS, "Flow",
          nullptr, "--no-inertia", nullptr,
          "Per-block motion-state persistence (the inertia prior's field): updated from MV + SAD against its own "
          "previous generation. The MVCOND inertia row reads it.")
PFG_LAYER_END(PERSISTENCE)

// rank 40 — --gme, the CPU affine fit (:44–134, :1535–1590). DEFAULT ON. Not called when gme_gpu is on (excludes).
PFG_LAYER(GME, "gme", FLOW, 40, H, true, false, PFG_BIT(FLOW_SOURCE), false, PFG_BIT(GME_GPU),
          CH_MV_RAW_FWD | CH_SAD, CH_GME | CH_DISSIDENCE, SH_NONE, PRIOR, "Flow",
          nullptr, "--no-gme", nullptr,
          "The frame-holon: a global affine model fitted per pair (IRLS on MV + SAD) and the dissidence mask of the "
          "blocks that disagree with it. CPU variant; gme_gpu replaces it when on.")
  PFG_PARAM(GME, irls2, BOOL, 0.f, 0.f, 1.f, "--gme-irls2", nullptr, PF_NONE, SWITCH,
            "2 IRLS passes (OLS + 1 reweight) instead of 3.")
PFG_LAYER_END(GME)

// rank 41 — --gme-gpu, the device-B variant (:303–372, :398–439, record :2008–2019). DEFAULT ON (forced off on
// single-GPU by the create-time cascade, flow_init.cpp:177–180).
PFG_LAYER(GME_GPU, "gme_gpu", FLOW, 41, P, true, false, PFG_BIT(GME), false, 0u,
          CH_MV_RAW_FWD | CH_SAD, CH_GME | CH_DISSIDENCE, SH_NONE, PRIOR, "Flow",
          "--gme-gpu", "--no-gme-gpu", nullptr,
          "The affine fit as a compute pass on device B (reduce→solve→mask); byte-equivalent to the CPU fit "
          "(--gme-gpu-verify cross-checks). Single-GPU rigs run the CPU row.")
  PFG_PARAM(GME_GPU, verify, BOOL, 0.f, 0.f, 1.f, "--gme-gpu-verify", nullptr, PF_IMPLIES_ON, SWITCH,
            "Run BOTH fits on the same pair and print the model / mask differences.")
PFG_LAYER_END(GME_GPU)

// rank 50 — the scene-holon, forward: advect + merge (:1259–1274, :1290–1310; call :1590–1595). DEFAULT ON.
// Shares --no-memory with mem_bwd / mem_refresh. Must precede objects (merge, then cluster the merged mask).
PFG_LAYER(MEM_FWD, "mem_fwd", FLOW, 50, H, true, false, PFG_BIT(OBJECTS), false, 0u,
          CH_MV_RAW_FWD | CH_DISSIDENCE | CH_MEM_PRIOR, CH_DISSIDENCE | CH_MEM_ADV, SH_NONE, HOLON, "Flow",
          nullptr, "--no-memory", nullptr,
          "Advect the persistent silhouette prior by the fwd MV field and merge it into the fresh dissidence mask "
          "(max(fresh, 0.55*prior)) before clustering.")
PFG_LAYER_END(MEM_FWD)

// rank 60 — the object-holon, forward (:885–1245; call :1604–1614). DEFAULT ON. Shares --no-objects with objects_bwd.
PFG_LAYER(OBJECTS, "objects", FLOW, 60, H, true, false, PFG_BIT(GME), false, 0u,
          CH_MV_RAW_FWD | CH_DISSIDENCE | CH_GME | CH_PERSIST | CH_OBJ_STATE,
          CH_MV_RAW_FWD | CH_DISSIDENCE | CH_PERSIST | CH_OBJ_STATE | CH_PAIR_STATS, SH_NONE, HOLON, "Flow",
          nullptr, "--no-objects", nullptr,
          "Connected-component clustering of the dissidence mask + 16-slot temporal identity + contour shape-field "
          "motion-inheritance repair of the MV field + the HUD shield; writes the matte mass.")
  PFG_PARAM(OBJECTS, shapefield, BOOL, 1.f, 0.f, 1.f, "--no-shapefield", nullptr, PF_NEGATED, SWITCH,
            "The contour shape-field repair (on) vs rigid single-MV inheritance (off).")
  PFG_PARAM(OBJECTS, fill_rim, BOOL, 1.f, 0.f, 1.f, "--obj-fill-rim", nullptr, PF_NO_FORM, SWITCH,
            "Coherent-MV interior infill: stamp the rigid slot MV across the whole silhouette including the rim.")
  PFG_PARAM(OBJECTS, expire, BOOL, 1.f, 0.f, 1.f, "--no-expire", nullptr, PF_NEGATED, SWITCH,
            "Stigmergy expiration of the slot MV on contradiction (on) vs pure EMA decay (off).")
  PFG_PARAM(OBJECTS, persist_reset, BOOL, 1.f, 0.f, 1.f, "--no-persist-reset", nullptr, PF_NEGATED, SWITCH,
            "Membership beats inertia: reset the persistence field inside an armed moving silhouette (fwd only).")
PFG_LAYER_END(OBJECTS)

// rank 70 — the backward affine fit (GPU :1515–1528, CPU :1697–1711). DEFAULT ON; runs when the bwd match did.
PFG_LAYER(GME_BWD, "gme_bwd", FLOW, 70, H, true, false, PFG_BIT(GME) | PFG_BIT(BIDIR), false, 0u,
          CH_MV_BWD | CH_SAD, CH_GME_BWD | CH_DISSIDENCE, SH_NONE, BWD, "Flow",
          nullptr, nullptr, nullptr,
          "The affine model + dissidence mask of the backward field (the CPU or the device-B variant, per gme_gpu).")
PFG_LAYER_END(GME_BWD)

// rank 71 — the scene-holon, backward merge (:1290–1310; call :1712–1716). Arm BWD: the backward legs run whenever the
// backward match did — they are not decimated by the tier shedding (step 3b, read from the code).
PFG_LAYER(MEM_BWD, "mem_bwd", FLOW, 71, H, true, false, PFG_BIT(MEM_FWD) | PFG_BIT(BIDIR), false, 0u,
          CH_DISSIDENCE | CH_MEM_ADV, CH_DISSIDENCE, SH_NONE, BWD, "Flow",
          nullptr, "--no-memory", nullptr,
          "Merge the advected prior into the backward dissidence mask before the backward clustering.")
PFG_LAYER_END(MEM_BWD)

// rank 72 — the object-holon, backward (call :1717–1729). Leaves the label scratch + the wake records mem_refresh reads.
PFG_LAYER(OBJECTS_BWD, "objects_bwd", FLOW, 72, H, true, false, PFG_BIT(OBJECTS) | PFG_BIT(BIDIR), false, 0u,
          CH_MV_BWD | CH_DISSIDENCE | CH_GME_BWD | CH_OBJ_STATE,
          CH_MV_BWD | CH_DISSIDENCE | CH_OBJ_STATE | CH_WAKE | CH_PAIR_STATS, SH_NONE, BWD, "Flow",
          nullptr, "--no-objects", nullptr,
          "The clustering + identity + repair over the backward field; emits the wake records (the object takes its "
          "silhouette with it) and the backward matte mass.")
PFG_LAYER_END(OBJECTS_BWD)

// rank 80 — the scene-holon refresh + wake evaporation (:1324–1380; call :1734–1739). The LAST holon.
PFG_LAYER(MEM_REFRESH, "mem_refresh", FLOW, 80, H, true, false, PFG_BIT(MEM_FWD), false, 0u,
          CH_MEM_ADV | CH_DISSIDENCE | CH_OBJ_STATE | CH_WAKE | CH_MV_RAW_FWD, CH_MEM_PRIOR, SH_NONE, HOLON, "Flow",
          nullptr, "--no-memory", nullptr,
          "Refresh / decay the persistent silhouette prior from the merged masks; evaporate the wakes the backward "
          "repair left (only when the backward legs ran).")
PFG_LAYER_END(MEM_REFRESH)

// rank 90 — the MV consensus pass (today present.cpp:734–765, medPipe, on P inside wap_upload; factory flow.cpp:442–469).
// DEFAULT ON. R5 gives it its OWN switch — the operator's declared default (the 1.7 px low-phase finding): today the
// pass was a second effect of --mv-guided. blind = the 3×3 vector median (--mv-median); otherwise the color-weighted
// consensus with mv_guided's band. Effective ON = on && (mv_guided on || blind).
PFG_LAYER(MV_CONSENSUS, "mv_consensus", FLOW, 90, P, true, false, PFG_BIT(FLOW_SOURCE), false, 0u,
          CH_MV_RAW_FWD | CH_MV_BWD | CH_CUR, CH_MV_RAW_FWD | CH_MV_BWD, SH_NONE, ALWAYS, "Flow",
          "--mv-consensus", "--no-mv-consensus", nullptr,
          "The 3x3 consensus over the MV field(s) before the warp: color-weighted (mv_guided's band) or the blind vector "
          "median (--mv-median). Its default is the operator's declared switch; --no-mv-consensus = the raw field.")
  PFG_PARAM(MV_CONSENSUS, blind, BOOL, 0.f, 0.f, 1.f, "--mv-median", nullptr, PF_IMPLIES_ON, SWITCH,
            "Blind 3x3 component-wise vector median (no color weighting).")
PFG_LAYER_END(MV_CONSENSUS)

